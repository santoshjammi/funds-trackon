# Environment Configuration for funds-trackon
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Ports ─────────────────────────────────────────────────────────────────────
FRONTEND_PORT=3002
BACKEND_PORT=8001
MONGO_PORT=27019

# ── CORS origins — keep in sync with FRONTEND_PORT ───────────────────────────
CORS_ORIGINS=["http://localhost:3002","http://127.0.0.1:3002"]

# ── Database — change DATABASE_NAME only; MONGODB_URL stays host-only ─────────
DATABASE_NAME=trackon_lead_management
MONGODB_URL=mongodb://mongo:27017/${DATABASE_NAME}

# ── OpenAI API ────────────────────────────────────────────────────────────────
OPENAI_API_KEY=your_openai_api_key_here

# ── Joplin Web Clipper REST API ───────────────────────────────────────────────
# Enable the Web Clipper Service in Joplin → Tools → Options → Web Clipper
# Then paste the API token shown there.
JOPLIN_API_TOKEN=your_joplin_api_token_here
# From Docker the host machine is reached via host.docker.internal:
JOPLIN_BASE_URL=http://host.docker.internal:41184

# ── OpenRouter (LLM for Joplin note extraction) ───────────────────────────────
# Get a free key at https://openrouter.ai
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Default model — free tier, strong reasoning:
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# ── Environment ───────────────────────────────────────────────────────────────
NODE_ENV=development
DEBUG=True
database_name=funds_trackon